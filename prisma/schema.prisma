// VendorPulse AI — Prisma schema
// SIH 2026 PS 26100 — AI-Powered Integrated Bid Compliance Verification Platform
//
// Datasource is PostgreSQL (Supabase). For an emergency offline demo you can
// switch `provider` to "sqlite" and set DATABASE_URL="file:./dev.db" (see README).
//
// NOTE ON ENUMS: status/result fields are modelled as `String` (not native
// Prisma enums) on purpose, so the allowed values live in one place in
// `src/lib/types.ts` and stay in sync with Zod validation. Allowed values are
// documented inline next to each field.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tender & requirements
// ---------------------------------------------------------------------------

model Tender {
  id                   String   @id @default(cuid())
  referenceNo          String   @unique
  title                String
  ministry             String
  category             String // e.g. "Goods", "Services"
  estimatedValue       Int // in INR
  bidSubmissionDeadline DateTime
  description          String

  requirements TenderRequirement[]
  rules        Rule[]
  bidders      Bidder[]
  runs         VerificationRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenderRequirement {
  id          String  @id @default(cuid())
  tenderId    String
  code        String // e.g. "REQ-EMD"
  title       String
  description String
  mandatory   Boolean @default(true)
  category    String // "Eligibility" | "Technical" | "Financial" | "Statutory"

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([tenderId, code])
}

// Deterministic compliance rules. scope/weightCategory drive the engines.
model Rule {
  id             String  @id @default(cuid())
  tenderId       String? // null => global statutory rule
  code           String  @unique
  title          String
  description    String
  scope          String // "STATUTORY" | "TENDER" | "DOCUMENT" | "CONSISTENCY"
  weightCategory String // "MANDATORY" | "STATUTORY" | "DOCUMENT" | "CONSISTENCY"
  severityOnFail String // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW"
  config         Json? // rule parameters (required source, fields to check, etc.)

  tender Tender? @relation(fields: [tenderId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// Bidder & documents
// ---------------------------------------------------------------------------

model Bidder {
  id                     String  @id @default(cuid())
  tenderId               String
  name                   String
  legalName              String
  pan                    String
  gstin                  String
  udyamNumber            String?
  cin                    String? // MCA company identification number
  msmeCategory           String? // "Micro" | "Small" | "Medium"
  isStartup              Boolean @default(false)
  address                String
  contactEmail           String
  contactPhone           String
  declaredLocalContentPct Int?
  // Demo annotation only — the engine does NOT read this. Documents the
  // intended outcome so the seed's realism can be checked.
  expectedRiskNote       String?

  tender    Tender            @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  documents Document[]
  runs      VerificationRun[]

  // Bandwidth Radar (capacity-exposure layer) — independent of compliance.
  gemAwards            GeMAward[]
  capacityProfile      VendorCapacityProfile?
  bandwidthAssessments BandwidthAssessment[]

  createdAt DateTime @default(now())
}

model Document {
  id                   String    @id @default(cuid())
  bidderId             String
  type                 String // see DocumentType in src/lib/types.ts
  fileName             String
  mimeType             String    @default("text/plain")
  content              String // seeded document text (stands in for OCR/parsed text)
  issueDate            DateTime?
  expiryDate           DateTime?
  status               String    @default("UPLOADED") // "UPLOADED"
  extractedFields      Json? // populated by the AI extraction step
  extractionConfidence Float?

  bidder Bidder @relation(fields: [bidderId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Verification run & results
// ---------------------------------------------------------------------------

model VerificationRun {
  id              String    @id @default(cuid())
  bidderId        String
  tenderId        String
  status          String    @default("PENDING") // "PENDING" | "COMPLETED" | "FAILED"
  complianceScore Int? // 0-100
  riskLevel       String? // "LOW" | "MODERATE" | "HIGH" | "CRITICAL"
  decisionStatus  String    @default("PENDING") // "PENDING" | "QUALIFIED" | "REJECTED"
  summary         String? // AI-generated human-readable summary
  recommendation  String? // AI recommendation (decision-support only)
  extractionMode  String? // "seeded" | "llm"
  scoreBreakdown  Json? // per-category subscores + weights
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  bidder          Bidder           @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  tender          Tender           @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  ruleResults     RuleResult[]
  findings        Finding[]
  discrepancies   Discrepancy[]
  providerResults ProviderResult[]
  auditEvents     AuditEvent[]
  decision        OfficerDecision?
}

model RuleResult {
  id        String  @id @default(cuid())
  runId     String
  ruleCode  String
  ruleTitle String
  category  String // weight category
  result    String // "PASS" | "FAIL" | "WARNING" | "PENDING" | "UNVERIFIED" | "NOT_APPLICABLE"
  detail    String
  evidence  Json?

  run VerificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Finding {
  id                  String  @id @default(cuid())
  runId               String
  finding             String
  severity            String // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW" | "INFO"
  confidence          Float // 0..1
  evidence            Json?
  affectedRequirement String?
  source              String  @default("AI_EXTRACTION")

  run VerificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model Discrepancy {
  id          String @id @default(cuid())
  runId       String
  kind        String // see DiscrepancyKind in src/lib/types.ts
  severity    String // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW"
  description String
  sources     Json // conflicting values keyed by source

  run VerificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model ProviderResult {
  id         String  @id @default(cuid())
  runId      String
  source     String // "GST" | "PAN" | "UDYAM" | "MCA" | "EPFO" | "ESIC" | "STARTUP_INDIA" | "NSIC" | "DEBARMENT"
  status     String // "VERIFIED" | "NOT_FOUND" | "MISMATCH" | "UNVERIFIED" | "ERROR"
  confidence Float?
  payload    Json // authoritative record returned by the (mock) provider
  isMock     Boolean @default(true)

  run VerificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Audit trail & officer decision
// ---------------------------------------------------------------------------

model AuditEvent {
  id           String   @id @default(cuid())
  runId        String?
  tenderId     String?
  bidderId     String?
  timestamp    DateTime @default(now())
  officer      String
  action       String // see AuditAction in src/lib/types.ts
  source       String?
  rule         String?
  result       String?
  evidence     Json?
  aiConfidence Float?
  decision     String?

  run VerificationRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([bidderId])
  @@index([tenderId])
  @@index([timestamp])
}

model OfficerDecision {
  id        String   @id @default(cuid())
  runId     String   @unique
  officer   String
  decision  String // "QUALIFIED" | "REJECTED"
  note      String?
  timestamp DateTime @default(now())

  run VerificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Bandwidth Radar — concurrent-obligation capacity exposure
// ---------------------------------------------------------------------------
//
// This layer is INDEPENDENT of the compliance pipeline above. It estimates
// whether a vendor can absorb another contract given its current concurrent GeM
// obligations. It is a capacity SIGNAL only and never sets qualification state.
//
// Award data is demo/simulated (source = "SEEDED", isMock = true). The provider
// abstraction (src/server/providers/gem-award.ts) lets a future authorized GeM
// award feed replace the seeded source without touching the exposure engine.

// One GeM contract awarded to a bidder. Only ACTIVE awards contribute to the
// vendor's live obligation load; COMPLETED and CANCELLED awards are excluded.
model GeMAward {
  id                String   @id @default(cuid())
  bidderId          String
  referenceNo       String   @unique // GeM contract/award reference (demo)
  title             String
  category          String // procurement category, e.g. "Goods", "Services"
  procuringOrg      String // awarding ministry / PSU / department
  state             String // region of performance, e.g. "Maharashtra"
  awardValue        Int // contract value in INR
  awardDate         DateTime
  contractStart     DateTime
  expectedCompletion DateTime
  status            String   @default("ACTIVE") // "ACTIVE" | "COMPLETED" | "CANCELLED"
  source            String   @default("SEEDED") // "SEEDED" | "GEM_PUBLIC"
  isMock            Boolean  @default(true)
  createdAt         DateTime @default(now())

  bidder Bidder @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([bidderId])
  @@index([status])
  @@index([state])
  @@index([category])
}

// Deterministic capacity inputs for a bidder. Stored (not client-provided) so
// the exposure engine always computes from server-trusted values. estimatedCapacity
// is derived transparently from turnover/category/workforce (see CAPACITY_MODEL).
model VendorCapacityProfile {
  id                          String   @id @default(cuid())
  bidderId                    String   @unique
  estimatedCapacity           Int // INR — concurrent order-book capacity
  capacityBasis               String // human-readable derivation of the number
  turnoverBasis               Int // INR — average annual turnover used
  workforceBasis              Int // declared headcount used
  recommendedExposureThreshold Int // exposure % beyond which a new award is flagged
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  bidder Bidder @relation(fields: [bidderId], references: [id], onDelete: Cascade)
}

// A point-in-time snapshot of a bidder's capacity exposure. Recomputed on demand
// by the deterministic engine; persisted for audit traceability.
model BandwidthAssessment {
  id                   String   @id @default(cuid())
  bidderId             String
  currentExposurePct   Float
  activeContractCount  Int
  activeObligationValue Int // INR — summed ACTIVE award values
  estimatedCapacity    Int // INR — capacity used for this snapshot
  remainingCapacityPct Float
  exposureLevel        String // "HEALTHY" | "WATCH" | "HIGH" | "CRITICAL"
  calculationEvidence  Json // included/excluded awards + math, for traceability
  assessedAt           DateTime @default(now())

  bidder Bidder @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([bidderId])
  @@index([assessedAt])
}
