# ---------------------------------------------------------------------------
# GeM BidGuard — environment configuration (SAMPLE)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (Supabase / PostgreSQL) --------------------------------------
# Use the Supabase "Connection string" (Transaction pooler recommended for
# serverless / Next.js). Example:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# For running migrations / db push, use the DIRECT connection (port 5432).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- AI document extraction -------------------------------------------------
# EXTRACTION_MODE controls which DocumentExtractor adapter is used:
#   "seeded" (default) -> deterministic offline extraction of the demo docs.
#                         Requires NO API key and NO network. Demo-safe.
#   "llm"              -> calls a real LLM over an OpenAI-compatible endpoint.
EXTRACTION_MODE="seeded"

# Only needed when EXTRACTION_MODE="llm". Works with any OpenAI-compatible
# Chat Completions endpoint that supports JSON output.
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"

# --- App --------------------------------------------------------------------
# Display name of the (mock) logged-in procurement officer used for audit
# attribution. No auth is implemented in this MVP.
OFFICER_NAME="Procurement Officer (Demo)"
OFFICER_ID="officer-001"
